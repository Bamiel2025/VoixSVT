# Copier ce fichier vers .env pour l'exécution locale. Ne jamais versionner .env.

# Code permettant d'ouvrir l'espace enseignant. Utilisez une valeur forte.
TEACHER_ACCESS_CODE=changez-moi

# Secret de signature des cookies de session enseignant (32 caractères minimum).
TEACHER_SESSION_SECRET=changez-ce-secret-avec-32-caracteres-minimum

# Web App Apps Script utilisée à la fois pour exporter et importer les résultats.
GOOGLE_SHEETS_APP_URL=https://script.google.com/macros/s/IDENTIFIANT/exec?key=VOTRE_CLE
GOOGLE_SHEETS_TIMEOUT=10

# Mettre 0 uniquement pour le test local HTTP ; Vercel doit garder 1.
COOKIE_SECURE=0
